package="AbstractionJobd"
displayname="Abstraction jobd"
version="0.2.0-1"
os_min_ver="6.2-24922"
arch="x86_64"
description="Downloads files on this NAS. Hand it a link from your PC and it keeps fetching while your machine sleeps, is closed, or is switched off - then the file is waiting for you on the NAS when you come back. Resumes after an interruption instead of starting again, and checks what it fetched against the digest before calling it done. Adds an Abstraction Downloads icon to the DSM desktop for starting a download here, choosing where files land, and how long they stay. Creates a shared folder called abstraction. https://github.com/openabstractions/addon-synology"
maintainer="openabstractions"
maintainer_url="https://github.com/openabstractions"
support_url="https://github.com/openabstractions/addon-synology/issues"
distributor="openabstractions"
distributor_url="https://github.com/openabstractions"
startable="yes"
silent_install="yes"
silent_upgrade="yes"
silent_uninstall="yes"
checksum="@@CHECKSUM@@"
